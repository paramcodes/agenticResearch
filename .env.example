# Local one-command stack: postgres + redis + api + web.
# Copy to .env at repo root, or export the vars before `docker compose up`.
#
#   cp .env.example .env
#   bun run docker:up        # build + start everything
#
# Frontend → http://localhost:5173 · API → http://localhost:4000

POSTGRES_USER=researcher
POSTGRES_PASSWORD=researcherpw
POSTGRES_DB=researcherit

# Resolved *inside* containers (service hostnames). Local non-docker dev uses
# the apps/*/​.env.example values with localhost instead.
DATABASE_URL="postgresql://researcher:researcherpw@postgres:5432/researcherit?schema=public"
REDIS_URL="redis://redis:6379"

PORT=4000
NODE_ENV=development
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
GOOGLE_CLIENT_ID=
ALLOW_INSECURE_GOOGLE_DEV=true

# Research agent (spec 02) — passed into the api container. Empty = offline
# deterministic mode; set both keys for live Planner→Writer→Editor runs.
# For Groq: set GROQ_API_KEY and use OPENAI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
RESEARCH_MODEL="openai/gpt-oss-20b"
SERPER_API_KEY=
MAX_REVISIONS=2

# Baked into the web image at build time (Vite statics).
VITE_API_URL="http://localhost:4000"
VITE_GOOGLE_CLIENT_ID=
