{
  "name": "researcherit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "bun --filter=@repo/db run db:generate",
    "db:migrate": "bun --filter=@repo/db run db:migrate",
    "db:deploy": "bun --filter=@repo/db run db:deploy",
    "db:seed": "bun --filter=@repo/db run db:seed",
    "build:vercel-api": "node scripts/bundle-vercel-api.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.4"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
