# Copy to .env and adjust. The api reads DATABASE_URL, REDIS_URL, JWT_*,
# CORS_ORIGIN and GOOGLE_* from here (see src/env.ts).
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://researcher:researcherpw@localhost:5432/researcherit?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
# Google login: create an OAuth client (Web) in Google Cloud Console and paste:
GOOGLE_CLIENT_ID=
# Dev-only fallback that decodes (not verifies) Google credentials.
# Keep false unless you knowingly test without a Google client id.
ALLOW_INSECURE_GOOGLE_DEV=true
