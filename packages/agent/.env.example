# Read by packages/agent at runtime (same process as the api — api's .env
# / compose environment wins; this file documents the knobs).
# Empty keys = deterministic offline mode (honestly labelled templates).

# Live LLM for planner/writer/editor (OpenAI or compatible endpoint):
OPENAI_API_KEY=
OPENAI_BASE_URL=
RESEARCH_MODEL="gpt-4o-mini"

# Live web research for planner + writer citations:
TAVILY_API_KEY=

# Editor→Writer revise cap:
MAX_REVISIONS=2

# LangGraph checkpointer. Set = Redis snapshots per node (resume by thread_id);
# unset/unreachable = in-process MemorySaver fallback.
REDIS_URL="redis://localhost:6379"
